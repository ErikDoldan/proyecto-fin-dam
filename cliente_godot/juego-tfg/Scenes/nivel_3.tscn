[node name="NPC" parent="." instance=ExtResource("7_0tgaq")]
texture_filter = 1
position = Vector2(152, 257)

[node name="Label" parent="NPC/PanelContainer" index="0"]
text = "Domi: \"¡Ey, frena un poco! Si te tiras por ahí a lo loco te vas a perder secretos importantes, y créeme, a algunos sitios es imposible volver a subir. Toma este Fragmento de Sombra. Si te lo equipas y mantienes pulsado el botón de salto en el aire, sacarás un planeador que te hará caer suavemente. ¡Úsalo para cruzar esos abismos y mirar bien antes de aterrizar!\""

[node name="NPC2" parent="." instance=ExtResource("7_0tgaq")]
texture_filter = 1
position = Vector2(1000, 625)

[node name="Label" parent="NPC2/PanelContainer" index="0"]
text = "Domi: \"Aquí tienes el Fragmento del Agua. Con él equipado, fluirás veloz como un torrente sin hacer ningún esfuerzo. ¡A veces, la mejor defensa es simplemente no estar ahí cuando el enemigo golpee!\""

[node name="NPC3" parent="." instance=ExtResource("7_0tgaq")]
texture_filter = 1
position = Vector2(1015, 145)

[node name="Label" parent="NPC3/PanelContainer" index="0"]
z_index = 1
text = "Domi: \"Una vez que te adentres en la montaña, mi camino se separará del tuyo; no podré acompañarte más allá de estas puertas. A partir de aquí, tendrás que hacer esto solo. He de confesarte algo... cuando empezamos, no estaba seguro de si lo lograrías, pero he visto cómo dominabas cada poder y superabas cada obstáculo con una determinación admirable. Ha sido un verdadero honor guiarte hasta aquí. Ahora, respira hondo y usa todo lo que has aprendido, porque me temo que lo que te espera ahí dentro será tu mayor desafío hasta ahora\""

