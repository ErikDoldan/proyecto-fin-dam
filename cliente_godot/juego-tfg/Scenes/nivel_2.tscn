[node name="Label" parent="NPC/PanelContainer" index="0"]
z_index = 1
text = "Domi: \"¡Hey,veo que  has conseguido llegar hasta aqui! Ahi delante en el cofre tienes el Fragmento de Fuego. Te va a venir de lujo; con esto podrás lanzar bolas de fuego y freír a los monstruos a distancia. Pero hazme caso en una cosa: no te vengas muy arriba. Hay bichos por ahí a los que el fuego les hace cosquillas, son totalmente inmunes. Así que úsalo, pero no te confíes.\""

[node name="NPC2" parent="." instance=ExtResource("6_amwks")]
position = Vector2(533, 593)

[node name="Label" parent="NPC2/PanelContainer" index="0"]
z_index = 1
text = "Domi:\"Mmm... No muchos tienen la agudeza para ver este camino. Ya veo que prestas atención a tu entorno. Te has ganado una recompensa en el cofre de ahi delante tienes el Fragmento de Piedra. Te envolverá en un escudo de energía capaz de absorber un impacto directo. Pero ten cuidado: una vez se quiebre, estarás totalmente expuesto hasta que logre regenerarse. Muévete con cabeza.\""

